{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Add specified mana symbols",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "symbols"],
  "properties": {
    "kind": { "const": "symbols" },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[^\\s{}]+$" }
    }
  }
}
