{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Any condition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "conditions"],
  "properties": {
    "kind": { "const": "any_of" },
    "conditions": { "type": "array", "minItems": 2, "items": { "$ref": "../condition.schema.json" } }
  }
}
