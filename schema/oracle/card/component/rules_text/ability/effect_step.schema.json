{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effect step",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "effect"],
  "properties": {
    "kind": { "const": "effect" },
    "effect": { "$ref": "../effect/effect.schema.json" },
    "optional": {
      "type": "boolean",
      "description": "Whether the player this effect names may choose not to follow it (CR 608.2d)."
    }
  }
}
