{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Translation",
  "description": "A file in data/translation/ such as data/translation/card/li/lightning-bolt/ja.json or data/translation/set/mh3/ja.json. The values of one language's paper, written only where they differ from the English.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lang", "card_id"],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "lang": {
      "type": "string",
      "description": "The language of this translation, such as ja."
    },
    "name": {
      "type": "string",
      "description": "The card name as printed in this language."
    },
    "type_line": {
      "type": "string",
      "description": "The type line as printed in this language."
    },
    "oracle_text": {
      "type": "string",
      "description": "The rules text on the paper of this language."
    },
    "power": {
      "type": "string"
    },
    "toughness": {
      "type": "string"
    },
    "loyalty": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string" }
      ]
    },
    "defense": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string" }
      ]
    },
    "history": {
      "type": "array",
      "description": "Records of official corrections to this translation. Appended only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "was", "corrected_at"],
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field"],
            "properties": {
              "field": { "type": "string" },
              "face": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "was": { "type": "string" },
          "note": { "type": "string" },
          "corrected_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
