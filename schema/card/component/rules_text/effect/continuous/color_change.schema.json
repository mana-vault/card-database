{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color change",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "operation", "color_ids"],
  "properties": {
    "kind": { "const": "color_change" },
    "operation": { "enum": ["set", "add", "remove"] },
    "color_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
    }
  }
}
