{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Characteristic change",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "subjects", "changes"],
  "properties": {
    "kind": { "const": "characteristic_change" },
    "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "../../target/target_subject.schema.json" } },
    "changes": { "type": "array", "minItems": 1, "items": { "$ref": "characteristic_delta.schema.json" } }
  }
}
