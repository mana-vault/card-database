{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color token",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "color_id"],
  "properties": {
    "kind": { "const": "color" },
    "color_id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
  }
}
