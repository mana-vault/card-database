{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zone condition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "subject", "operator", "zones"],
  "properties": {
    "kind": { "const": "zone" },
    "subject": { "$ref": "../../target/target_subject.schema.json" },
    "operator": { "enum": ["is_in", "is_not_in"] },
    "zones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["battlefield", "stack", "graveyard", "exile", "hand", "library", "ante", "command"] }
    }
  }
}
