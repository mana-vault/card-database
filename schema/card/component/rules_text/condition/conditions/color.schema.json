{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color condition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "subject", "operator", "color_ids"],
  "properties": {
    "kind": { "const": "color" },
    "subject": { "$ref": "../../target/target_subject.schema.json" },
    "operator": { "enum": ["has_any", "has_all", "has_none"] },
    "color_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
    }
  }
}
