{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spell ability",
  "description": "Instructions followed while an instant or sorcery spell resolves (CR 113.3a). The card's mana cost is a characteristic, not part of this ability.",
  "allOf": [
    { "$ref": "base.schema.json" },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "spell" },
        "body": { "$ref": "body.schema.json" },
        "casting_costs": { "$ref": "../cost/casting_costs.schema.json" }
      },
      "required": ["kind", "body"]
    }
  ],
  "unevaluatedProperties": false
}
