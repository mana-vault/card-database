{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calculation",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "operator", "operands"],
  "properties": {
    "kind": { "const": "calculation" },
    "operator": { "enum": ["sum", "difference", "product", "maximum", "minimum"] },
    "operands": { "type": "array", "minItems": 2, "items": { "$ref": "amount.schema.json" } }
  }
}
