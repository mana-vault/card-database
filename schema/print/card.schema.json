{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Words of a card",
  "description": "A file under data/print/<lang>/card/. The words a paper of this language shows for a card. The words every print of the card shows the same way live in base/entity/, one file per card; a print whose words differ from the base holds its own file at card/<set>/<number>.json, keyed by the print. A card whose layout holds several faces holds the words the same way the card does, in the fields named for the faces. Flavor text is not here: it belongs to the print.",
  "oneOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "$ref": "#/$defs/base_split"
    },
    {
      "$ref": "#/$defs/base_front_back"
    },
    {
      "$ref": "#/$defs/exception"
    },
    {
      "$ref": "#/$defs/exception_split"
    },
    {
      "$ref": "#/$defs/exception_front_back"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "card_id",
        "name"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/card_id"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "name": {
          "type": "string",
          "description": "The card name as printed in this language."
        },
        "type_line": {
          "$ref": "#/$defs/type_line"
        },
        "rules_text": {
          "$ref": "#/$defs/rules_text"
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    },
    "base_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "card_id",
        "left",
        "right"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/card_id"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "left": {
          "$ref": "#/$defs/face_words"
        },
        "right": {
          "$ref": "#/$defs/face_words"
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "card_id",
        "set_code",
        "number"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/card_id"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "set_code": {
          "type": "string",
          "description": "The official code of the product whose print shows words of its own, such as STA."
        },
        "number": {
          "type": "string",
          "description": "The collector number of the print that shows words of its own, as printed; e.g. 170 or 170★."
        },
        "name": {
          "type": "string",
          "description": "The card name as this print shows it, when it differs from the base."
        },
        "type_line": {
          "$ref": "#/$defs/type_line"
        },
        "rules_text": {
          "$ref": "#/$defs/rules_text"
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    },
    "exception_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "card_id",
        "set_code",
        "number"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/card_id"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "set_code": {
          "type": "string",
          "description": "The official code of the product whose print shows words of its own, such as STA."
        },
        "number": {
          "type": "string",
          "description": "The collector number of the print that shows words of its own, as printed; e.g. 170 or 170★."
        },
        "left": {
          "$ref": "#/$defs/face_words"
        },
        "right": {
          "$ref": "#/$defs/face_words"
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    },
    "face_words": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of this face as printed in this language."
        },
        "type_line": {
          "$ref": "#/$defs/type_line"
        },
        "rules_text": {
          "$ref": "#/$defs/rules_text"
        }
      }
    },
    "type_line": {
      "type": "object",
      "additionalProperties": false,
      "description": "The supertypes, card types, and subtypes as this language prints them.",
      "properties": {
        "supertypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "card_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "subtypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rules_text": {
      "type": "object",
      "additionalProperties": false,
      "description": "The rules text as this language prints it, one entry per ability of the card.",
      "required": [
        "abilities"
      ],
      "properties": {
        "abilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ability_id",
              "text"
            ],
            "properties": {
              "ability_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "description": "The ability_id of the ability this text belongs to in the card."
              },
              "text": {
                "type": "string",
                "description": "The rules text of that ability as printed in this language."
              }
            }
          }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Records of official corrections to these words. Appended only; past records are never rewritten.",
      "items": {
        "$ref": "../correction.schema.json"
      }
    },
    "card_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "lang": {
      "type": "string",
      "description": "The language of these words, such as ja."
    },
    "base_front_back": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "card_id",
        "front",
        "back"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/card_id"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "front": {
          "$ref": "#/$defs/face_words"
        },
        "back": {
          "$ref": "#/$defs/face_words"
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    },
    "exception_front_back": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "card_id",
        "set_code",
        "number"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/card_id"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "front": {
          "$ref": "#/$defs/face_words"
        },
        "back": {
          "$ref": "#/$defs/face_words"
        },
        "history": {
          "$ref": "#/$defs/history"
        },
        "set_code": {
          "type": "string",
          "description": "The official code of the product whose print shows words of its own, such as STA."
        },
        "number": {
          "type": "string",
          "description": "The collector number of the print that shows words of its own, as printed; e.g. 170 or 170★."
        }
      }
    }
  }
}
