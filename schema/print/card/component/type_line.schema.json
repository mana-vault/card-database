{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Type-line words",
  "description": "The type line as this face shows it in this language: the supertypes, card types, and subtypes as words.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "supertypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "card_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "subtypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
